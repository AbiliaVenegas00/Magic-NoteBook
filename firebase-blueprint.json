{
  "entities": {
    "user": {
      "title": "User Profile",
      "description": "Information about an authenticated user",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "deletedTaskIds": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["uid"]
    },
    "task": {
      "title": "Calendar Task / Plan",
      "description": "A scheduled task or plan for a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "category": { "type": "string" },
        "createdAt": { "type": "string" },
        "completedAt": { "type": "string" },
        "googleEventId": { "type": "string" },
        "syncedWithGoogle": { "type": "boolean" }
      },
      "required": ["id", "userId", "title", "dueDate", "status", "priority"]
    },
    "goal": {
      "title": "Goal with checklist tasks",
      "description": "A structured goal containing specific checklist tasks",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "targetDays": { "type": "number" },
        "targetDate": { "type": "string" },
        "targetCount": { "type": "number" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "userId", "title"]
    },
    "note": {
      "title": "Quick Note",
      "description": "A user note or quick reminder",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "content"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "user",
      "description": "User profile document accessible only by the owner"
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": "task",
      "description": "Individual calendar tasks owned by the user"
    },
    "/users/{userId}/goals/{goalId}": {
      "schema": "goal",
      "description": "Goals owned by the user"
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": "note",
      "description": "Quick notes owned by the user"
    }
  }
}
